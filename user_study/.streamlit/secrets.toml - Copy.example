# Copy this file to secrets.toml (same folder) for local testing, and paste
# the same content into the app's "Secrets" panel once it is deployed on
# Streamlit Community Cloud. Never commit the real secrets.toml - it holds
# a private key. See ../README.md for where these values come from.

[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

[sheet]
url = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"
